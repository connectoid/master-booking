# Скопируйте в .env и заполните
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking
# Для Alembic используется тот же URL, драйвер подменяется на psycopg автоматически

MAX_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Публичный адрес бэкенда/Mini App (для вебхуков и ссылок)
PUBLIC_BASE_URL=https://example.ru

# Сколько часов считается свежим initData из Mini App
INITDATA_MAX_AGE_HOURS=24
