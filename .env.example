# Скопируйте в .env и заполните
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking
# Для Alembic используется тот же URL, драйвер подменяется на psycopg автоматически

MAX_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Публичный адрес бэкенда/Mini App (для вебхуков и ссылок)
PUBLIC_BASE_URL=https://example.ru

# Сколько часов считается свежим initData из Mini App
INITDATA_MAX_AGE_HOURS=24

# MAX: секрет вебхука (придумайте: латиница/цифры/_/-, 5–256 символов)
MAX_WEBHOOK_SECRET=
# Ник бота вида id1234567890_bot (необязательно — узнаем через API)
MAX_BOT_USERNAME=
# Сертификат Минцифры для platform-api2.max.ru, если не установлен в систему
MAX_CA_FILE=

# Telegram: секрет вебхука (латиница/цифры/_/-, до 256 символов)
TELEGRAM_WEBHOOK_SECRET=
# Ник бота без @ (необязательно — узнаем через API)
TELEGRAM_BOT_USERNAME=
# Адрес Bot API; поменяйте, только если api.telegram.org недоступен с сервера
TELEGRAM_API_BASE=https://api.telegram.org

# Веб-версия: секрет подписи ссылок и сессий браузера (длинная случайная строка).
# Пусто — выводится из MAX_BOT_TOKEN (тогда смена токена разлогинит браузеры).
WEB_SECRET=

# Реквизиты для главной страницы и политики конфиденциальности
SITE_OWNER_NAME=
SITE_INN=
SITE_OGRNIP=
SITE_EMAIL=

# Админка (okoshko.website/admin): ваш ID в MAX — бот покажет по команде /myid. Несколько — через запятую.
ADMIN_MAX_IDS=
